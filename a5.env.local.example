# =============================================================================
#  a5.env.local.example — OPTIONAL per-machine overrides. Copy and edit only if
#  you need one:
#
#      cp a5.env.local.example a5.env.local
#
#  You do not need this file. Everything lives in a5.env's EDIT BLOCK, which is
#  the one place to edit per server. This file exists for two cases:
#
#    1. a value you want kept out of a5.env — a proxy with credentials in it,
#       say, or a path you would rather not copy to another machine;
#    2. a machine where you want to differ from a5.env without editing it.
#
#  It is loaded BEFORE a5.env and WINS over it, so anything set here makes the
#  matching line in a5.env's EDIT BLOCK have no effect. load_env.sh says so in
#  its report, so an override cannot silently shadow an edit you just made.
#
#  Never commit it; .gitignore and .dockerignore both exclude it, so it cannot
#  reach a commit or an image.
#
#  Keep the  NAME="${NAME:-value}"  form, so an environment variable on the
#  command line still wins:   HOST_HOME=/home/bob ./run_container.sh
#
#  Precedence, highest first:
#      environment  >  --env-file FILE  >  a5.env.local  >  a5.env
#
#  Loading first is what makes this file win, and it is also its one limit:
#  nothing a5.env defines exists yet. "${HOST_HOME}/code/vllm" here is an
#  unbound variable, not your home — write the path out, or derive it with
#  $(id -un) as below. load_env.sh refuses the file rather than let it through.
# =============================================================================

# Your login name, if $USER is not set in the shells you use (cron, some ssh
# setups). a5.env resolves it from $USER, then `id -un`, so this is rarely needed.
# RUN_USER="${RUN_USER:-bob}"

# The three paths from a5.env's EDIT BLOCK, if you want them here instead. In
# full, or via $(id -un) — not ${HOST_HOME}, which a5.env has not set yet.
# HOST_HOME="${HOST_HOME:-/home/bob}"
# VLLM_DIR="${VLLM_DIR:-/home/$(id -un)/code/vllm}"
# VLLM_ASCEND_DIR="${VLLM_ASCEND_DIR:-/home/$(id -un)/code/vllm-ascend}"

# A checkout that lives outside your home. Space-separated "src:dst[:ro]".
# EXTRA_MOUNTS="${EXTRA_MOUNTS:-/mnt/nvme1n1_data:/mnt/nvme1n1_data}"

# Take only part of a shared box. Check `npu-smi info` for how ids map to chips.
# DEVICES="${DEVICES:-0,1,2,3}"
# CPUSET="${CPUSET:-0-63}"
# MEM_LIMIT="${MEM_LIMIT:-512g}"
# SHM_SIZE="${SHM_SIZE:-200g}"

# A proxy, kept out of the shared file. NOTE: a URL with credentials in it ends
# up in the container's environment, where `docker inspect` shows it.
# BUILD_HTTPS_PROXY="${BUILD_HTTPS_PROXY:-http://proxy:8080}"

# Don't use your own vllm at all — the container takes it from the image and
# VLLM_DIR is ignored. For when you only ever edit vllm-ascend.
# VLLM_FROM="${VLLM_FROM:-image}"
