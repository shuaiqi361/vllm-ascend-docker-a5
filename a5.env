#!/usr/bin/env bash
# =============================================================================
#  a5.env — every setting in this bundle. Sourced by every script; never run.
#
#  On a new server, edit the EDIT BLOCK below and nothing else. Everything
#  under it has a working default; override one for a single run instead of
#  editing it:                 SHM_SIZE=200g ./run_container.sh dbg
#
#  Why a knob exists, and every trap worth knowing: NOTES.md.
#  Checks all of it and reports every problem at once:
#                              ./run_container.sh --dry-run
# =============================================================================

# Your login name, for container names and the owner label. $USER is not set in
# every shell (cron, some ssh setups), so it is resolved once, here.
RUN_USER="${RUN_USER:-${USER:-$(id -un 2>/dev/null || echo dev)}}"

# =============================================================================
#  EDIT BLOCK — the only lines you should need to touch per server.
# =============================================================================

# The image containers RUN. Any image with CANN + torch-npu + a compiler will
# do: your code is mounted into it, never baked. See what is already here with
#     ./probe_image.sh --list        then  ./probe_image.sh <ref>  for a verdict
IMAGE="${IMAGE:-vllm-ascend-a5-dev:latest}"                               # <<< EDIT

# Your home. Mounted at this same absolute path and used as HOME inside, so ~/
# means the same directory in both places.
HOST_HOME="${HOST_HOME:-/home/${RUN_USER}}"                               # <<< EDIT

# Your two checkouts. Both are `pip install -e`'d at container start, so python
# edits are live. Both must be under HOST_HOME, under HOST_DATA, or in
# EXTRA_MOUNTS — otherwise they are not in the container at all.
VLLM_DIR="${VLLM_DIR:-${HOST_HOME}/code/vllm}"                            # <<< EDIT
VLLM_ASCEND_DIR="${VLLM_ASCEND_DIR:-${HOST_HOME}/code/vllm-ascend}"       # <<< EDIT

# The disk holding model weights and datasets, shared by everyone on the box.
# Find it with:   df -h | sort -k2 -h | tail -5
HOST_DATA="${HOST_DATA:-/data}"                                           # <<< EDIT

# The SoC the custom kernels compile for. Get it from the box with
# `npu-smi info -t board -i 0` ("Chip Name" + "NPU Name"), lowercased:
#   950PR ascend950pr_9579   950DT ascend950dt_9582   A3 ascend910_9391
SOC_VERSION="${SOC_VERSION:-ascend950pr_9579}"                            # <<< EDIT

# BUILD ONLY — what ./build_image.sh builds ON. Ignore it unless you build.
# These three are the reference vllm-ascend's own Dockerfile.a5.openEuler uses.
# Its tag carries a build date, and the registry is not reachable from every
# network, so the default is often wrong on a new server; NOTES.md "Keeping up
# with upstream" says how to find one you can actually pull.
CANN_REGISTRY="${CANN_REGISTRY:-swr.cn-north-12.myhuaweicloud.com/atlas_inference/cann}"
CANN_VERSION="${CANN_VERSION:-9.3.0_20261113161300}"
CANN_IMAGE_SUFFIX="${CANN_IMAGE_SUFFIX:-950-openeuler24.03-py3.12}"
BASE_IMAGE="${BASE_IMAGE:-${CANN_REGISTRY}:${CANN_VERSION}-${CANN_IMAGE_SUFFIX}}"  # <<< EDIT

# =============================================================================
#  Defaults below. Working values — change one only for a reason.
# =============================================================================

# ── paths inside the image ───────────────────────────────────────────────────
# Container paths. Never looked for on this machine; nothing here must provide
# them. Written down once, and threaded through the Dockerfile and tools/.
ASCEND_HOME="${ASCEND_HOME:-/usr/local/Ascend}"   # where CANN lives in the base
DEV_TOOLS_DIR="${DEV_TOOLS_DIR:-/opt/vllm-dev}"   # where tools/ lands
UPSTREAM_DIR="${UPSTREAM_DIR:-/opt/upstream}"     # the SEED_DEPS baseline

# ── your paths, continued ────────────────────────────────────────────────────
# Where the container's vllm comes from: "checkout" (yours, editable, live) or
# "image" (the baseline already inside; VLLM_DIR is then not mounted). vllm-
# ascend is always your checkout — that is what this bundle is for.
VLLM_FROM="${VLLM_FROM:-checkout}"
# Extra read/write mounts, space separated "src:dst" or "src:dst:ro".
EXTRA_MOUNTS="${EXTRA_MOUNTS:-}"
# HOME inside the container. Pointing it at the mounted home keeps pip/HF/torch
# caches on the host instead of dying with the container.
CONTAINER_HOME="${CONTAINER_HOME:-${HOST_HOME}}"
# Where build_image.sh writes its log; falls back to $TMPDIR if not writable.
LOG_DIR="${LOG_DIR:-${HOST_HOME}/logs/vllm-a5-docker}"

# ── the host's NPU driver ────────────────────────────────────────────────────
# The CANN toolkit comes from the image. The DRIVER cannot: it is kernel-side
# and belongs to the machine, so a container has to be handed its device nodes
# and libraries. That is why run_container.sh, not build_image.sh, checks these.
ASCEND_DRIVER_DIR="${ASCEND_DRIVER_DIR:-/usr/local/Ascend/driver}"
ASCEND_FIRMWARE_DIR="${ASCEND_FIRMWARE_DIR:-/usr/local/Ascend/firmware}"
# How the chips reach the container, and how much of the driver is mounted.
# Which one works is a property of the HOST. Each is also a run_container.sh
# flag, so trying another costs no edit. See NOTES.md "DEVICE_MODE and
# DRIVER_MOUNT" before changing either.
#   DEVICE_MODE   privileged (A3/A5 guide) | devices (one --device per chip) | visible
#   DRIVER_MOUNT  full (guide: driver + firmware, rw) | lib64 | none
DEVICE_MODE="${DEVICE_MODE:-privileged}"
DRIVER_MOUNT="${DRIVER_MOUNT:-full}"
# Read by the Ascend Docker Runtime if the host has it, inert otherwise. NODRV
# = "mount the chips, not the driver dirs". Emptied when DRIVER_MOUNT=none.
ASCEND_RUNTIME_OPTIONS="${ASCEND_RUNTIME_OPTIONS:-NODRV}"
# Host files the NPU runtime needs. Mounted read-only at the same path; a
# missing one WARNS, because a healthy Ascend box has all of these.
DRIVER_RO_MOUNTS="${DRIVER_RO_MOUNTS:-/usr/local/dcmi /usr/local/bin/npu-smi /etc/ascend_install.info}"
# Same, but silent when absent: these are per-family and per-topology.
OPTIONAL_RO_MOUNTS="${OPTIONAL_RO_MOUNTS:-/etc/hccn.conf /lib/route.conf /etc/hccl_rootinfo.json /etc/hixlep /etc/vnpu.cfg}"

# ── containers ───────────────────────────────────────────────────────────────
# Container name is <prefix>-<suffix>; the suffix is run_container.sh's first arg.
NAME_PREFIX="${NAME_PREFIX:-${RUN_USER}-vllm-a5}"
# "auto" = every /dev/davinci<N> the host exposes. Otherwise a comma list of
# ids. Check `npu-smi info` first: on A3 one chip = two dies = two nodes.
DEVICES="${DEVICES:-auto}"
# SHM_SIZE is what matters for vLLM — docker's default 64m is far too small.
# "auto" = half of host RAM. MEM_LIMIT empty = unlimited, right on a box you own.
SHM_SIZE="${SHM_SIZE:-auto}"
MEM_LIMIT="${MEM_LIMIT:-}"
# Empty CPUS = all cores. CPUSET pins them — use it when several containers
# share a box and you care about NUMA locality.
CPUS="${CPUS:-}"
CPUSET="${CPUSET:-}"
# host = no NAT, every container port is the host's port, which is what you want
# for `vllm serve`. "bridge" plus PUBLISH_PORTS ("8000:8000 7001:7001") isolates.
NETWORK="${NETWORK:-host}"
PUBLISH_PORTS="${PUBLISH_PORTS:-}"
# 1 = --privileged (some profiling and very large --shm-size setups need it).
PRIVILEGED="${PRIVILEGED:-0}"
# 1 = SYS_PTRACE + unconfined seccomp, so gdb / py-spy / msprof can attach.
DEBUG_CAPS="${DEBUG_CAPS:-1}"
# 1 = drop into an interactive shell once the container is up.
ATTACH="${ATTACH:-1}"
# How long `docker stop` waits for a clean shutdown in manage_containers.sh.
STOP_TIMEOUT="${STOP_TIMEOUT:-30}"

# ── the container-side scripts ───────────────────────────────────────────────
# Where the container gets entrypoint.sh / bootstrap_editable.sh / ascend_env.sh:
#   1    (default) always bind-mount this folder's tools/ read-only. What makes
#        an image nobody built for this bundle usable exactly as it is, and what
#        makes an edit to tools/ take effect on the next --recreate.
#   auto the image's baked copies when it has them (it says so with a label),
#        tools/ when it does not.
#   0    always the image's own copies.
# With auto or 0 on an image that has them baked in, your edits to tools/ do
# NOT run; run_container.sh md5s both sides and warns. See NOTES.md.
MOUNT_TOOLS="${MOUNT_TOOLS:-1}"

# 1 = on container start, install your checkouts editable and build the kernels
# if they are missing. Turn it off only to debug the bootstrap itself.
BOOTSTRAP_ON_START="${BOOTSTRAP_ON_START:-1}"
# Where the bootstrap logs inside the container, and the flag file it writes
# holding ok / failed / skipped. run_container.sh waits on the flag and reads
# it, so both sides take the paths from here.
BOOTSTRAP_LOG="${BOOTSTRAP_LOG:-/tmp/bootstrap_editable.log}"
BOOTSTRAP_DONE_FLAG="${BOOTSTRAP_DONE_FLAG:-/tmp/.vllm-dev-bootstrap-done}"
# How long run_container.sh waits before leaving it in the background. A first
# kernel build can take tens of minutes, hence the generous default.
BOOTSTRAP_TIMEOUT="${BOOTSTRAP_TIMEOUT:-7200}"

# ── the custom kernels ───────────────────────────────────────────────────────
# 1 = compile vllm-ascend's custom kernels into your checkout when missing.
# Tens of minutes, ONCE per checkout — the result lands on the host and survives
# the container. 0 only for pure-python work: the custom ops will then fail.
COMPILE_CUSTOM_KERNELS="${COMPILE_CUSTOM_KERNELS:-1}"
# Bound build parallelism, and therefore memory. Empty = one job per core, which
# can OOM a shared node on the heavy csrc / rust compiles (vllm-ascend CI passes
# 32 on a 32-core node). MAX_JOBS caps both the image build and the in-container
# kernel build; CARGO_BUILD_JOBS is route B only — the rust frontend is built
# into the image and never rebuilt in a container.
MAX_JOBS="${MAX_JOBS:-}"
CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-}"
# How both sides recognise a finished kernel build — read by run_container.sh to
# predict and by bootstrap_editable.sh to decide, so they cannot disagree about
# what "already built" means. See NOTES.md "The kernel marker".
KERNEL_SO_GLOB="${KERNEL_SO_GLOB:-vllm_ascend/*vllm_ascend_C*.so}"
KERNEL_MARKER="${KERNEL_MARKER:-.vllm-ascend-dev-build}"
# Build output lives in your checkout, so it outlives containers. When the
# marker says it was made for a different SoC, python, image, source commit or
# box — or there is output and no marker, which is what a killed build leaves —
# the bootstrap REMOVES it before installing instead of building on top of it.
# 1 here also drops csrc/build_cache, turning that into a total rebuild; it is
# content-keyed, so the default keeps it.
# See NOTES.md "Build provenance, and purging a cache you cannot trust".
PURGE_BUILD_CACHE="${PURGE_BUILD_CACHE:-0}"
# The submodule the ACLNN half of the custom-op build needs.
CATLASS_MARKER="${CATLASS_MARKER:-csrc/third_party/catlass/include}"

# ── pip, inside the container and at build time ──────────────────────────────
# PIP_INDEX_URL is the PRIMARY index. Point it at an internal mirror if you have
# one. It is passed into the container too: the image's own pip.conf is written
# at BUILD time, which does nothing on route A where nothing is built.
PIP_INDEX_URL="${PIP_INDEX_URL:-https://pypi.org/simple}"
PYTORCH_INDEX_URL="${PYTORCH_INDEX_URL:-https://download.pytorch.org/whl/cpu/}"
# SPACE-SEPARATED, passed as PIP_EXTRA_INDEX_URL. The nightly one carries the
# memfabric / memcache / FLA wheels that requirements.txt pins.
ASCEND_INDEX_URL="${ASCEND_INDEX_URL:-https://repo.huaweicloud.com/ascend/repos/pypi https://repo.huaweicloud.com/ascend/repos/pypi/nightly}"

# Versions this IMAGE needs corrected, re-applied by the bootstrap on every
# container start (a pip install you do by hand is lost on --recreate; this is
# not). An entry may also be "name@/absolute/path" to install that directory
# editable instead. Every entry here has a reason — read NOTES.md "PIP_PINS and
# PIP_GUARD_PACKAGES" before adding, removing or re-pinning one. In particular
# the ais_bench_benchmark version is date-stamped and fails obscurely when wrong.
PIP_PINS="${PIP_PINS:-pyarrow==17.0.0 torchvision==0.25.0 torchaudio==2.10.0 numpy==1.26.4 transformers>=5.21.1 numba concurrent-log-handler quart ais_bench_benchmark[full]>=3.1.20260630}"

# The binary ABI, frozen at whatever THIS IMAGE has. The bootstrap adds
# "name==<installed version>" for each to the pip constraints file, so nothing
# pulled in by PIP_PINS can move them — pip reports a conflict instead. ADD to
# this list rather than removing from it.
PIP_GUARD_PACKAGES="${PIP_GUARD_PACKAGES:-torch torch-npu triton-ascend numpy}"

# Proxies for `docker build` and for pip inside the container. Never baked into
# an image. NO_PROXY_HOSTS also seeds the container's no_proxy, which
# run_container.sh extends with this host's own names — a serve on localhost
# must never be proxied. See NOTES.md "no_proxy".
BUILD_HTTP_PROXY="${BUILD_HTTP_PROXY:-${http_proxy:-}}"
BUILD_HTTPS_PROXY="${BUILD_HTTPS_PROXY:-${https_proxy:-}}"
NO_PROXY_HOSTS="${NO_PROXY_HOSTS:-${no_proxy:-localhost,127.0.0.1}}"

# cmake's TLS verification, read from the ENVIRONMENT by cmake 3.30+. 0 = do not
# verify, which is what a proxy that intercepts https needs: pip survives such a
# proxy, the kernel build does not. 1 = verify. Empty = leave cmake's default.
# This one is worth reading NOTES.md "CMAKE_TLS_VERIFY" about.
CMAKE_TLS_VERIFY="${CMAKE_TLS_VERIFY:-0}"

# ── route B: what a build installs ───────────────────────────────────────────
# Only read by ./build_image.sh. BASE_KIND is the one choice; it derives
# SEED_DEPS, SYS_PACKAGES and every INSTALL_* below, so "build on an image that
# already works" cannot half-happen.
#   cann  (default) BASE_IMAGE is a plain CANN image. Builds everything.
#   ready BASE_IMAGE is already a vllm-ascend runtime image. Adds only the dev
#         plumbing — seconds, a few MB.
BASE_KIND="${BASE_KIND:-cann}"
# The one build step that can disturb a working base: update (distro update then
# the package list) | install (the list only) | skip. yum and apt-get both work.
SYS_PACKAGES="${SYS_PACKAGES:-update}"

# 1 = clone UPSTREAM vllm + vllm-ascend into UPSTREAM_DIR and install them, so
# every dependency is already present and a container's first start is seconds.
# Your checkouts are not involved. See NOTES.md "SEED_DEPS".
SEED_DEPS="${SEED_DEPS:-1}"
# The refs that baseline is built from. vllm-ascend main pins a vLLM tag and
# that pin MOVES — re-check after every sync of your checkout:
#     grep -m1 'ARG VLLM_TAG' <your vllm-ascend>/Dockerfile.a5.openEuler
UPSTREAM_VLLM_REPO="${UPSTREAM_VLLM_REPO:-https://github.com/vllm-project/vllm.git}"
UPSTREAM_VLLM_TAG="${UPSTREAM_VLLM_TAG:-v0.34.0}"
UPSTREAM_VLLM_COMMIT="${UPSTREAM_VLLM_COMMIT:-}"      # a full sha; wins over the tag
UPSTREAM_VLLM_ASCEND_REPO="${UPSTREAM_VLLM_ASCEND_REPO:-https://github.com/vllm-project/vllm-ascend.git}"
UPSTREAM_VLLM_ASCEND_REF="${UPSTREAM_VLLM_ASCEND_REF:-main}"

# vLLM's optional Rust frontend. Needs cargo (the base has it); costs minutes.
INSTALL_RUST_FRONTEND="${INSTALL_RUST_FRONTEND:-1}"
# requirements-dev.txt (pytest, lint, lm-eval) so `pytest tests/ut` works inside.
INSTALL_DEV_REQS="${INSTALL_DEV_REQS:-1}"

# A5 extras, from vllm-ascend's Dockerfile.a5.openEuler. Change these TOGETHER
# with the base image, not on their own: the versions are matched to its CANN.
# The per-family values (-a5 / -a3 / -a2, 950 / 910, A5 / A3) are in NOTES.md
# "Another machine or NPU family".
INSTALL_FLA="${INSTALL_FLA:-1}"                 # gated delta-rule / conv ops
FLA_PACKAGE="${FLA_PACKAGE:-flash-linear-attention-npu-a5}"
FLA_VERSION="${FLA_VERSION:-26.10.0+feature}"
FLASH_ATTN_NPU_VERSION="${FLASH_ATTN_NPU_VERSION:-0.5.1.post1}"
FLASH_ATTN_BUILD_NPU="${FLASH_ATTN_BUILD_NPU:-950}"
MF_SOC="${MF_SOC:-A5}"                          # memfabric kernel pack, via mfcli
INSTALL_CANNBOT="${INSTALL_CANNBOT:-1}"         # A5 only; a missing wheel skips
CANNBOT_DSL_VERSION="${CANNBOT_DSL_VERSION:-0.8.2}"
CANNBOT_NET_OPS_VERSION="${CANNBOT_NET_OPS_VERSION:-0.3.0}"
INSTALL_MOONCAKE="${INSTALL_MOONCAKE:-1}"       # disaggregated prefill / KV transfer
MOONCAKE_VERSION="${MOONCAKE_VERSION:-0.3.14}"

# ── miscellaneous run-time ───────────────────────────────────────────────────
# 1 = LD_PRELOAD jemalloc in every shell. Keep it at 1 for expert offload, whose
# pinned host expert store makes the host allocator matter; 0 for a clean log
# (it costs one torch_npu LD_PRELOAD warning per process).
ASCEND_JEMALLOC="${ASCEND_JEMALLOC:-1}"
